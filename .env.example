# ─── Home Utilities Dashboard — environment ────────────────────────────────
# Copy to `.env` and fill in. `.env` is gitignored; never commit real values.

# Where all persistent data lives (SQLite DB, config, and inbox/ of raw bills).
# In Docker this is the mounted volume, e.g. /data. Locally ./data is fine.
DATA_DIR=./data

# HTTP port the app listens on.
PORT=3000

# ─── Auth ──────────────────────────────────────────────────────────────────
# Secret used to sign session cookies. At least 32 random characters.
# Generate one with:  openssl rand -base64 48
AUTH_SECRET=change-me-to-a-long-random-string-at-least-32-chars
# How many days a login session lasts.
AUTH_SESSION_DAYS=7

# ─── Household defaults (used when the household record is first created) ──
# ISO 4217 currency code, BCP 47 locale, IANA timezone.
DEFAULT_CURRENCY=AUD
DEFAULT_LOCALE=en-AU
DEFAULT_TIMEZONE=Australia/Melbourne
# Month the financial year starts (1 = January, 7 = July).
DEFAULT_FISCAL_YEAR_START_MONTH=7

# ─── Bills mailbox (IMAP) — Phase 3 ────────────────────────────────────────
# A dedicated mailbox that receives only utility bills. For Gmail use an
# app password (Google Account → Security → App passwords).
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_SECURE=true
IMAP_USER=
IMAP_PASSWORD=
IMAP_MAILBOX=INBOX
# How often to poll, in seconds. Set to 0 to disable the poller.
IMAP_POLL_INTERVAL_SECONDS=300

# ─── LLM extraction (Anthropic API) — Phase 3 ──────────────────────────────
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5
# Parses below this confidence (0–1) go to the manual-review queue.
EXTRACTOR_CONFIDENCE_THRESHOLD=0.85

# ─── Misc ──────────────────────────────────────────────────────────────────
# Seed a fictional household for demos instead of real data.
DEMO_MODE=false
# debug | info | warn | error
LOG_LEVEL=info

# ─── Software update (Settings → Software update) ──────────────────────────
# Set by the release workflow inside the image; leave unset locally ("dev").
# APP_COMMIT=
# APP_BUILT_AT=
# GitHub repo (owner/repo) whose release workflow publishes the image, and a
# fine-grained read-only token (Actions + Contents) for that repo only. Leave
# the token empty to skip update checks; "Install latest release" still works.
UPDATE_REPO=ThyGlizzyGlobber/Home-Utilities-Software--Prototype-1-
UPDATE_GITHUB_TOKEN=
UPDATE_WORKFLOW=release.yml
UPDATE_BRANCH=main

# ─── Accounts and sign-in ─────────────────────────────────────────────────
# Public address of the app (used in emails and the Google redirect).
APP_URL=
# Emails that may run software updates and mailbox polling (comma-separated).
OPERATOR_EMAILS=
# Google sign-in: OAuth client from Google Cloud → Google Auth Platform → Clients.
# Redirect URI: <APP_URL>/api/auth/google/callback. Leave empty to hide the button.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Invitations and sign-in codes are sent with Resend (resend.com).
RESEND_API_KEY=
EMAIL_FROM=Home Utilities <no-reply@localhost>
# true = write emails to the server log instead of sending them.
EMAIL_LOG_ONLY=false
# Days a PIN unlock lasts; days a browser stays trusted after a full sign-in.
AUTH_DEVICE_DAYS=180

# ─── Household bills addresses (Cloudflare Email Routing → Email Worker) ─────
# {alias} is each household's part, e.g. {alias}@brjlabs.com or
# bills+{alias}@bills.brjlabs.com. Leave empty to turn bills addresses off.
BILLS_ADDRESS_TEMPLATE=
# Shared with deploy/email-worker (openssl rand -hex 32).
INBOUND_EMAIL_SECRET=
INBOUND_MAX_PER_HOUR=60
# AI bill reads per household per month.
AI_MONTHLY_LIMIT=60
