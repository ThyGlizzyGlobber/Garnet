# ─── Home Utilities Dashboard — environment ────────────────────────────────
# Copy to `.env` and fill in. `.env` is gitignored; never commit real values.

# Where all persistent data lives (SQLite DB, config, and inbox/ of raw bills).
# In Docker this is the mounted volume, e.g. /data. Locally ./data is fine.
DATA_DIR=./data

# HTTP port the app listens on.
PORT=3000

# ─── Auth ──────────────────────────────────────────────────────────────────
# Secret used to sign session cookies. At least 32 random characters.
# Generate one with:  openssl rand -base64 48
AUTH_SECRET=change-me-to-a-long-random-string-at-least-32-chars
# How many days a login session lasts.
AUTH_SESSION_DAYS=30

# ─── Household defaults (used when the household record is first created) ──
# ISO 4217 currency code, BCP 47 locale, IANA timezone.
DEFAULT_CURRENCY=AUD
DEFAULT_LOCALE=en-AU
DEFAULT_TIMEZONE=Australia/Melbourne
# Month the financial year starts (1 = January, 7 = July).
DEFAULT_FISCAL_YEAR_START_MONTH=7

# ─── Bills mailbox (IMAP) — Phase 3 ────────────────────────────────────────
# A dedicated mailbox that receives only utility bills. For Gmail use an
# app password (Google Account → Security → App passwords).
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_SECURE=true
IMAP_USER=
IMAP_PASSWORD=
IMAP_MAILBOX=INBOX
# How often to poll, in seconds. Set to 0 to disable the poller.
IMAP_POLL_INTERVAL_SECONDS=300

# ─── LLM extraction (Anthropic API) — Phase 3 ──────────────────────────────
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
# Parses below this confidence (0–1) go to the manual-review queue.
EXTRACTOR_CONFIDENCE_THRESHOLD=0.85

# ─── Misc ──────────────────────────────────────────────────────────────────
# Seed a fictional household for demos instead of real data.
DEMO_MODE=false
# debug | info | warn | error
LOG_LEVEL=info
