# ─── Garnet (BRJ Labs) — environment ────────────────────────────────
# Copy to `.env` and fill in. `.env` is gitignored; never commit real values.
# Every variable is validated in src/lib/env.ts; blank values count as unset.

# Where all persistent data lives (SQLite DB, config, inbox/ of bill files,
# originals/). In Docker this is the mounted volume, /data. Locally ./data.
DATA_DIR=./data

# HTTP port the app listens on.
PORT=3000

# ─── Accounts and sign-in ─────────────────────────────────────────────────
# Secret used to sign session cookies and codes. At least 32 random characters.
# Generate one with:  openssl rand -base64 48
AUTH_SECRET=change-me-to-a-long-random-string-at-least-32-chars
# Bill files encrypted at rest: 32 random bytes, base64 (openssl rand -base64 32).
# Each household's files are sealed with its own key, wrapped by this one.
# Leave empty to keep files plain. Once set and used, never lose it: without
# it the stored bills can't be opened and the app won't start.
DATA_KEY=
# Days a PIN unlock (or a fresh sign-in) lasts before the PIN is asked again.
AUTH_SESSION_DAYS=7
# Days a browser stays trusted after a full sign-in (Google or emailed code).
AUTH_DEVICE_DAYS=180
# Public address of the app (used in emails and the Google redirect).
APP_URL=
# Emails of the developers who run the install: the console, software updates,
# service types (comma-separated). OPERATOR_EMAILS is the old name and still works.
# have no AI monthly limit.
DEVELOPER_EMAILS=
# Google sign-in: OAuth client from Google Cloud → Google Auth Platform → Clients.
# Redirect URI: <APP_URL>/api/auth/google/callback. Leave empty to hide the button.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Sign-in codes, invitations and reminders are sent with Resend (resend.com).
# Without a key, production sends nothing, so nobody can sign in by email.
RESEND_API_KEY=
EMAIL_FROM=Garnet <no-reply@localhost>
# true = write emails to the server log instead of sending them (local testing).
EMAIL_LOG_ONLY=false

# ─── Household defaults (used when a household is first created) ───────────
# ISO 4217 currency code, BCP 47 locale, IANA timezone.
DEFAULT_CURRENCY=AUD
DEFAULT_LOCALE=en-AU
DEFAULT_TIMEZONE=Australia/Melbourne
# Month the financial year starts (1 = January, 7 = July).
DEFAULT_FISCAL_YEAR_START_MONTH=7

# ─── Household bills addresses (Cloudflare Email Routing → Email Worker) ─────
# {alias} is each household's part, e.g. {alias}@brjlabs.com or
# bills+{alias}@bills.brjlabs.com. Leave empty to turn bills addresses off.
BILLS_ADDRESS_TEMPLATE=
# Shared with deploy/email-worker (openssl rand -hex 32).
INBOUND_EMAIL_SECRET=
# Messages accepted per household per hour on its bills address.
INBOUND_MAX_PER_HOUR=60

# ─── AI bill reader (Anthropic API) ────────────────────────────────────────
# Without a key every document waits in the Inbox for entry by hand.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5
# Only for an organisation-wide key (the API then asks for one): the workspace ID from the Console.
ANTHROPIC_WORKSPACE_ID=
# Reads below this confidence (0–1) wait in the Inbox for a person to check.
EXTRACTOR_CONFIDENCE_THRESHOLD=0.85
# AI reads per household per month (the console can set a household's own cap, or none).
AI_MONTHLY_LIMIT=60

# ─── Weather (households with a postcode) ─────────────────────────────────
# open-meteo | off. Open-Meteo's free API is for non-commercial use; a paid
# product needs their commercial key.
WEATHER_PROVIDER=open-meteo
OPEN_METEO_API_KEY=
# Heating / cooling degree-day base temperatures, °C.
WEATHER_HDD_BASE=18
WEATHER_CDD_BASE=18

# ─── Area comparisons ─────────────────────────────────────────────────────
# on | off. Figures pooled from households that share anonymised figures; an
# area figure is only kept with at least REGIONAL_MIN_HOUSEHOLDS behind it (min 5).
REGIONAL_INSIGHTS=on
REGIONAL_MIN_HOUSEHOLDS=10

# ─── Demo ─────────────────────────────────────────────────────────────────
# Seed the fictional "Riverside House" household for demos.
DEMO_MODE=false

# ─── Software update (Settings → Software update) ──────────────────────────
# Set by the release workflow inside the image; leave unset locally ("dev").
# APP_COMMIT=
# APP_BUILT_AT=
# GitHub repo (owner/repo) whose release workflow publishes the image, and a
# fine-grained read-only token (Actions + Contents) for that repo only. Leave
# the token empty to skip update checks; "Install latest release" still works.
UPDATE_REPO=ThyGlizzyGlobber/Home-Utilities-Software--Prototype-1-
UPDATE_GITHUB_TOKEN=
UPDATE_WORKFLOW=release.yml
UPDATE_BRANCH=main
