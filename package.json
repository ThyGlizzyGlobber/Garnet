{
  "name": "home-utilities-dashboard",
  "version": "0.4.0",
  "private": true,
  "description": "Self-hosted household utilities dashboard — BRJ Labs Prototype 1",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "postbuild": "node -e \"const fs=require('fs');fs.cpSync('.next/static','.next/standalone/.next/static',{recursive:true});fs.cpSync('public','.next/standalone/public',{recursive:true});fs.cpSync('drizzle','.next/standalone/drizzle',{recursive:true});fs.cpSync('reference','.next/standalone/reference',{recursive:true})\"",
    "start": "sh -c 'DATA_DIR=\"${DATA_DIR:-$PWD/data}\" node --env-file-if-exists=.env .next/standalone/server.js'",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "knip": "knip",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run lint && npm run typecheck && npm run format:check && npm run knip && npm run test",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --env-file-if-exists=.env --import tsx src/db/migrate.ts",
    "db:studio": "drizzle-kit studio",
    "db:seed:demo": "node --env-file-if-exists=.env --import tsx scripts/seed.ts",
    "extract:dry-run": "node --env-file-if-exists=.env --import tsx scripts/extract-dry-run.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.128.0",
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^13.0.3",
    "drizzle-orm": "^0.45.3",
    "imapflow": "^2.0.6",
    "iron-session": "^9.0.1",
    "mailauth": "^7.1.0",
    "mailparser": "^3.9.28",
    "next": "16.3.6",
    "next-intl": "^4.14.6",
    "pdf-lib": "^1.17.1",
    "pdf-parse": "^2.4.5",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "recharts": "^3.10.1",
    "sharp": "^0.35.5",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/better-sqlite3": "^9.6.0",
    "@types/mailparser": "^3.4.6",
    "@types/node": "^22.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9.39.0",
    "eslint-config-next": "16.3.6",
    "knip": "^6.38.0",
    "postcss": "^8.5.28",
    "prettier": "^3.9.9",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.0.1"
  }
}
